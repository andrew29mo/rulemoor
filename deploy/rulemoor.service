[Unit]
Description=Rulemoor confirmed firewall changes
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
UMask=0077
StateDirectory=rulemoor
StateDirectoryMode=0700
ExecStart=/opt/rulemoor/venv/bin/rulemoor-agent --state /var/lib/rulemoor serve --listen 127.0.0.1 --port 18443 --cert /etc/rulemoor/server.pem --key /etc/rulemoor/server.key --token-file /etc/rulemoor/token
Restart=on-failure
RestartSec=1
TimeoutStopSec=15
KillMode=control-group
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_ADMIN CAP_KILL
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/rulemoor
UnsetEnvironment=RULEMOOR_FAULT

[Install]
WantedBy=multi-user.target
